<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <permission android:name="android.permission.RECORD_AUDIO" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".config.wiring.MyApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Car">
        <service
            android:name="proto.media.fiezta.features.domain.car.app.CarService"
            android:label="@string/car_service_name"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>
        <service
            android:name="proto.media.fiezta.features.domain.mediaserver.PlaybackBrowserService"
            android:label="@string/car_media_service_name"
            android:icon="@mipmap/ic_csmedia"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="com.google.android.gms.car.application.theme"
            android:resource="@style/Theme.Car" />
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_csmedia_mark" />

        <activity
            android:name="proto.media.fiezta.features.layout.MainPhoneActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|navigation|density"
            android:theme="@style/Theme.Browser"
            android:windowSoftInputMode="stateUnspecified|adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="proto.media.fiezta.features.domain.phone.settings.SettingsPhoneActivity"
            android:label="@string/settings"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|navigation|density"
            android:theme="@style/Theme.Settings"
            android:parentActivityName=".features.layout.MainPhoneActivity">
        </activity>

        <activity
            android:name="proto.media.fiezta.features.domain.phone.browser.SiteStorageActivity"
            android:label="@string/settings_site_storage_title"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|navigation|density"
            android:theme="@style/Theme.Settings"
            android:parentActivityName=".features.domain.phone.settings.SettingsPhoneActivity" />

        <activity
            android:name="proto.media.fiezta.features.domain.phone.plugins.PluginsPhoneActivity"
            android:label="@string/plugins_title"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|navigation|density"
            android:theme="@style/Theme.Settings"
            android:parentActivityName=".features.domain.phone.settings.SettingsPhoneActivity" />
        <activity
            android:name="proto.media.fiezta.features.domain.phone.plugins.VoiceListenerPhoneActivity"
            android:label="@string/voice_listener_title"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|navigation|density"
            android:theme="@style/Theme.Settings"
            android:parentActivityName=".features.domain.phone.plugins.PluginsPhoneActivity" />

        <activity
            android:name="proto.media.fiezta.features.domain.phone.plugins.PluginDetailsPhoneActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|navigation|density"
            android:theme="@style/Theme.Settings"
            android:parentActivityName=".features.domain.phone.plugins.PluginsPhoneActivity" />
        <activity
            android:name="proto.media.fiezta.features.domain.phone.warnings.WarningsPhoneActivity"
            android:label="@string/app_warnings"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|navigation|density"
            android:theme="@style/Theme.Settings" />
    </application>

</manifest>