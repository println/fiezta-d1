<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ToolbarButton" parent="@android:style/Widget.ImageButton">
        <item name="android:padding">16dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/car_toolbar_button_background</item>
    </style>

    <style name="Theme.Car" parent="Base.Theme.AppCompat">
        <item name="colorAccent">@color/brandPrimary</item>
        <item name="colorControlActivated">@color/brandPrimary</item>
    </style>

    <style name="Theme.Browser" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/brandBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/brandPrimary</item>
        <item name="colorControlActivated">@color/brandPrimary</item>
        <item name="popupMenuStyle">@style/PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/PopupMenu.Overflow</item>
        <item name="textAppearanceLargePopupMenu">@style/PopupMenuText</item>
        <item name="textAppearanceSmallPopupMenu">@style/PopupMenuText</item>
        <item name="alertDialogTheme">@style/DialogStyle</item>
    </style>

    <style name="Theme.Settings" parent="Theme.AppCompat">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/background</item>
        <item name="colorAccent">@color/brandSecondary</item>
        <item name="colorControlActivated">@color/brandSecondary</item>
        <item name="android:textColorPrimary">@color/primaryText</item>
        <item name="android:textColorSecondary">@color/secondaryText</item>
        <item name="android:preferenceLayoutChild">@layout/preference_row</item>
        <item name="actionBarStyle">@style/SettingsActionBar</item>
        <item name="popupMenuStyle">@style/PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/PopupMenu.Overflow</item>
        <item name="textAppearanceLargePopupMenu">@style/PopupMenuText</item>
        <item name="textAppearanceSmallPopupMenu">@style/PopupMenuText</item>
        <item name="alertDialogTheme">@style/DialogStyle</item>
    </style>

    <!-- contentInsetStart must also be zero: contentInsetStartWithNavigation alone still pushes the title away from the arrow. -->
    <style name="SettingsActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="contentInsetStartWithNavigation">0dp</item>
        <item name="contentInsetStart">0dp</item>
        <item name="background">@color/background</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/browser_menu_background</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="PopupMenu.Overflow">
        <item name="overlapAnchor">true</item>
    </style>

    <style name="PopupMenuText" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/primaryText</item>
    </style>

    <style name="ButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/primaryText</item>
    </style>

    <style name="DialogStyle" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/doorhanger_background</item>
        <item name="android:background">@drawable/doorhanger_background</item>
        <item name="android:textColorPrimary">@color/primaryText</item>
        <item name="android:textColorSecondary">@color/secondaryText</item>
        <item name="colorAccent">@color/primaryText</item>
    </style>

    <style name="SearchField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/search_field_background</item>
        <item name="android:drawableStart">@drawable/mozac_ic_search</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/secondaryText</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textColorHint">@color/secondaryText</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
