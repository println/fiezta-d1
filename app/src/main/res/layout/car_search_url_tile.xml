<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/car_search_url_tile_height"
    android:layout_marginBottom="@dimen/car_search_spacing"
    android:background="@drawable/car_settings_tonal_background"
    android:focusable="true"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/engine_button_icon"
        android:layout_width="@dimen/car_search_url_circle_size"
        android:layout_height="@dimen/car_search_url_circle_size"
        android:background="@drawable/car_search_engine_circle"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:padding="@dimen/car_search_url_icon_padding"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/engine_button_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:textColor="@color/car_settings_on_active"
        android:textSize="14sp" />
</LinearLayout>
