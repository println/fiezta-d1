    <string name="settings_home_url_summary">Адрес, который открывает кнопка «Главная»</string>

    <string name="settings_restore_last_url_title">Продолжить с того же места</string>
    <string name="settings_restore_last_url_summary">Действует только для экрана автомобиля: возвращает к последней странице вместо домашней. На телефоне главный экран всегда открывается пустым.</string>

    <string name="settings_third_party_cookies_title">Разрешить сторонние файлы cookie</string>
    <string name="settings_third_party_cookies_summary">Нужно для сохранения входа в Google/YouTube. Вступит в силу только при следующем подключении к автомобилю.</string>

    <string name="settings_protected_content_title">Разрешить защищённый контент (DRM)</string>
    <string name="settings_protected_content_summary">Нужно для стриминговых сервисов. Может не работать на проецируемом экране.</string>

    <string name="settings_strip_wv_ua_title">Скрывать, что это WebView</string>
    <string name="settings_strip_wv_ua_summary">Вступает в силу после перезапуска приложения. Некоторые сервисы отказывают WebView. Может изменить вёрстку других сайтов.</string>
